{
    // ====================================================================
    // jsconfig.json - JavaScript Project Configuration for IDE/IntelliSense
    // ====================================================================
    // This file tells VS Code (and other IDEs) how to understand your 
    // JavaScript project. It enables features like:
    //   - Autocomplete suggestions
    //   - Go to definition (Ctrl+Click)
    //   - Find all references
    //   - Hover documentation
    //   - Error detection (optional)
    //
    // NOTE: This file does NOT affect runtime behavior - it's purely for
    // the IDE to provide better developer experience.
    // ====================================================================
    "compilerOptions": {
        // --------------------------------------------------------------------
        // target: Which JavaScript version to understand
        // --------------------------------------------------------------------
        // ES2022 = Modern JavaScript (async/await, optional chaining, etc.)
        // Options: ES5, ES6, ES2015, ES2016, ES2017, ES2018, ES2019, ES2020, 
        //          ES2021, ES2022, ESNext
        "target": "ES2022",
        // --------------------------------------------------------------------
        // module: How modules are handled
        // --------------------------------------------------------------------
        // ESNext = Modern import/export syntax
        // Not strictly needed for browser scripts, but helps IDE understand code
        "module": "ESNext",
        // --------------------------------------------------------------------
        // lib: Which built-in APIs the IDE should know about
        // --------------------------------------------------------------------
        // ES2022 = Modern JS methods (Array.at(), Object.hasOwn(), etc.)
        // DOM = document, window, HTMLElement, fetch(), etc.
        // DOM.Iterable = NodeList forEach, etc.
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        // --------------------------------------------------------------------
        // checkJs: Enable/disable type checking on .js files
        // --------------------------------------------------------------------
        // true = Show red squiggly lines for potential type errors
        // false = Only provide autocomplete, no error checking
        // 
        // TIP: Set to false if you find the errors annoying. You can still
        // enable checking per-file by adding // @ts-check at the top.
        "checkJs": false,
        // --------------------------------------------------------------------
        // strict: Enable all strict type checking options
        // --------------------------------------------------------------------
        // false = Relaxed checking (recommended for existing JS projects)
        // true = Very strict (like TypeScript strict mode)
        "strict": false,
        // --------------------------------------------------------------------
        // noEmit: Don't generate output files
        // --------------------------------------------------------------------
        // true = This is just for IDE, don't try to compile anything
        "noEmit": true,
        // --------------------------------------------------------------------
        // skipLibCheck: Skip type checking of declaration files
        // --------------------------------------------------------------------
        // true = Faster IDE performance, skip checking .d.ts files
        "skipLibCheck": true,
        // --------------------------------------------------------------------
        // moduleResolution: How to find imported modules
        // --------------------------------------------------------------------
        // bundler = Modern resolution (for Vite, webpack, etc.)
        // node = Node.js style resolution
        "moduleResolution": "bundler",
        // --------------------------------------------------------------------
        // allowSyntheticDefaultImports: Allow default imports from modules
        // --------------------------------------------------------------------
        // true = import foo from 'bar' even if bar doesn't have default export
        "allowSyntheticDefaultImports": true,
        // --------------------------------------------------------------------
        // resolveJsonModule: Allow importing .json files
        // --------------------------------------------------------------------
        // true = IDE understands: import data from './config.json'
        "resolveJsonModule": true
    },
    // ====================================================================
    // include: Which files to analyze
    // ====================================================================
    // Glob patterns for files the IDE should process
    "include": [
        "src/**/*.js"
    ],
    // ====================================================================
    // exclude: Which files to ignore
    // ====================================================================
    // Glob patterns for files the IDE should skip
    "exclude": [
        "node_modules",
        "dist",
        "build"
    ]
}